# ============================================================
# WordPress 環境設定テンプレート
# このファイルを .env にコピーして各自の値を設定してください。
#   cp .env.example .env
# ============================================================

# --- データベース ---
MYSQL_ROOT_PASSWORD=<強力なランダムパスワードを設定>
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_user
MYSQL_PASSWORD=<強力なランダムパスワードを設定>

# --- WordPress ---
WORDPRESS_DB_HOST=db
WORDPRESS_DB_USER=wp_user
WORDPRESS_DB_PASSWORD=<MYSQL_PASSWORD と同じ値>
WORDPRESS_DB_NAME=wordpress

# --- WP 初期設定 ---
WP_URL=http://localhost:8080
WP_TITLE=CloudWorks WordPress
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=<英大小文字・数字・記号を含む 20 文字以上を推奨>
WP_ADMIN_EMAIL=admin@example.com
WP_INIT_WAIT_SECONDS=60
