{
  // Dev Container の表示名
  "name": "CloudWorks WordPress",
  // 使用する Docker Compose ファイル（db + wordpress の 2 サービス構成）
  "dockerComposeFile": "../compose.yaml",
  // VS Code がアタッチするサービス名（wordpress コンテナ内で作業する）
  "service": "wordpress",
  // Compose 起動時に合わせて立ち上げるサービス（db を先に起動しておく）
  "runServices": [
    "db",
    "wordpress"
  ],
  // コンテナ内でのワークスペースパス
  "workspaceFolder": "/workspaces/wordpress",
  // ホストのリポジトリルートをコンテナ内にマウントする
  // consistency=cached: macOS / WSL2 で I/O パフォーマンスを改善するヒント
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/wordpress,type=bind,consistency=cached",
  // コンテナ内の実行ユーザー（WP-CLI や Composer を root で動かすため root を指定）
  "remoteUser": "root",
  // コンテナ内に追加で設定する環境変数
  "remoteEnv": {
    "HOME": "/root",
    // Codex（AI エージェント）の設定ディレクトリ
    "CODEX_HOME": "/root/.codex"
  },
  // true にすると devcontainer がデフォルトコマンドを上書きしてしまうため false にする
  "overrideCommand": false,
  // VS Code ウィンドウを閉じたとき Compose 全体を停止する
  "shutdownAction": "stopCompose",
  // ホスト側に転送するポート
  // 8080: WordPress フロントエンド / 管理画面
  // 9003: Xdebug（VS Code からステップ実行するために使用）
  "forwardPorts": [
    8080,
    9003
  ],
  // ポートごとのラベルと自動転送時の動作設定
  "portsAttributes": {
    "8080": {
      "label": "WordPress",
      // 転送が有効になったら通知を出す
      "onAutoForward": "notify"
    },
    "9003": {
      "label": "Xdebug"
    }
  },
  "customizations": {
    "vscode": {
      // コンテナ起動時に自動インストールされる拡張機能
      "extensions": [
        "xdebug.php-debug", // Xdebug によるステップ実行
        "bmewburn.vscode-intelephense-client", // PHP 補完・定義ジャンプ
        "johnbillion.vscode-wordpress-hooks", // WordPress フック補完
        "ms-azuretools.vscode-containers", // Docker / Compose の GUI 操作
        "redhat.vscode-yaml", // YAML 補完・バリデーション
        "openai.chatgpt" // ChatGPT / Codex 統合
      ],
      "settings": {
        // PHP バイナリのパス（コンテナ内）
        "php.validate.executablePath": "/usr/local/bin/php",
        // Intelephense に WordPress コアのパスを教える（補完精度が上がる）
        "intelephense.environment.includePaths": [
          "/var/www/html"
        ],
        // .php ファイルを常に PHP として認識させる
        "files.associations": {
          "*.php": "php"
        },
        // デフォルトシェルを bash に固定
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  // コンテナ初回作成後に 1 度だけ実行するコマンド
  // 各ツールのバージョンを表示して動作確認する
  "postCreateCommand": "php -v && wp --info --allow-root && codex --version",
  // コンテナ起動のたびに実行するコマンド
  // WordPress の初期インストールと管理者ユーザーの確認・作成を行う
  "postStartCommand": "bash /workspaces/wordpress/scripts/devcontainer/bootstrap-wordpress.sh"
}